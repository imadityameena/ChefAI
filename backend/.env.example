# Backend environment variables
# Copy this file to .env and fill in the values

# Server
PORT=5000
NODE_ENV=development

# PostgreSQL connection string (Render, Neon, Supabase, or local)
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DB_NAME

# JWT signing secret (use a long random string; the server won't start without it)
JWT_SECRET=your_jwt_secret_key_here

# Google Gemini API key
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend URL(s) allowed by CORS, comma-separated, no trailing slash.
# localhost:5173 is allowed automatically when NODE_ENV is not "production".
FRONTEND_URL=https://your-vercel-frontend-url.vercel.app
